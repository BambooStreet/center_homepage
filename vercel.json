{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/.image-slots.state.json", "destination": "/api/image-slots" },
    { "source": "/(about|assessment|therapy|intensive|outreach|guide)", "destination": "/index.html" },
    { "source": "/(about|assessment|therapy|intensive|outreach|guide)/(.*)", "destination": "/index.html" },
    { "source": "/(business|rooms|programs|archive|news|apply)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
